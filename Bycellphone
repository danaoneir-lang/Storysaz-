<div class="row"><span class="label">محو</span><input type="range" id="dblBlur" min="0" max="30" value="0"></div>
<div class="row"><span class="label">سیاه و سفید</span><input type="range" id="dblGray" min="0" max="100" value="0"></div>
<button class="reset" id="removeImg2">🗑 حذف لایه دوم</button>
</div>

<!-- متن -->
<div class="panel" id="tab-text">
<textarea id="txt" placeholder="متن خود را بنویسید...">هر روز،
یک قدم بهتر</textarea>
<div class="row" style="margin-top:10px"><span class="label">اندازه فونت</span><input type="range" id="sz" min="30" max="200" value="90"></div>
<div class="row"><span class="label">فاصله خطوط</span><input type="range" id="lh" min="100" max="250" value="140"></div>
<div class="row"><span class="label">موقعیت</span>
<div class="chips" id="pos">
<button class="chip" data-p="top">بالا</button>
<button class="chip active" data-p="center">وسط</button>
<button class="chip" data-p="bottom">پایین</button>
