<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>استودیو استوری</title>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;700;900&family=Lalezar&family=Estedad:wght@400;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{background:#0a0a0a;color:#f5f5f5;font-family:Vazirmatn,sans-serif;height:100vh;overflow:hidden;display:flex;flex-direction:column;max-width:500px;margin:auto}
header{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-bottom:1px solid #1f1f1f}
h1{font-size:13px;font-weight:900}
button.export{background:#fff;color:#000;border:0;padding:8px 14px;border-radius:100px;font-family:inherit;font-weight:700;font-size:12px}
.layer-bar{display:flex;gap:4px;padding:8px 14px;background:#141414;border-bottom:1px solid #1f1f1f;overflow-x:auto;scrollbar-width:none}
.layer-bar::-webkit-scrollbar{display:none}
.layer-btn{min-width:72px;background:transparent;border:1px solid #1f1f1f;color:#888;padding:6px 10px;border-radius:8px;font-family:inherit;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap}
.layer-btn.active{background:#fff;color:#000;border-color:#fff}
.canvas-wrap{flex:1;display:flex;align-items:center;justify-content:center;padding:12px;overflow:hidden;position:relative}
canvas{max-width:100%;max-height:100%;border:1px solid #1f1f1f;border-radius:4px;touch-action:none;background:#fff}
.grid-toggle{position:absolute;top:20px;right:20px;background:rgba(0,0,0,.6);color:#fff;border:1px solid rgba(255,255,255,.2);padding:6px 10px;border-radius:6px;font-family:inherit;font-size:11px;cursor:pointer;z-index:10}
.grid-toggle.active{background:#fff;color:#000}
.controls{background:#141414;border-top:1px solid #1f1f1f;padding:12px 14px 16px;max-height:50vh;overflow-y:auto}
.controls::-webkit-scrollbar{width:3px}.controls::-webkit-scrollbar-thumb{background:#1f1f1f}
.row{display:flex;gap:8px;margin-bottom:9px;align-items:center}
.label{font-size:11px;color:#888;min-width:62px}
.chip{background:transparent;border:1px solid #1f1f1f;color:#888;padding:6px 12px;border-radius:100px;font-family:inherit;font-size:12px;cursor:pointer;white-space:nowrap}
.chip.active{background:#fff;color:#000;border-color:#fff}
.chips{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none;flex-wrap:nowrap}
.chips::-webkit-scrollbar{display:none}
textarea{width:100%;background:#0a0a0a;border:1px solid #1f1f1f;color:#f5f5f5;padding:10px 12px;border-radius:8px;font-family:Vazirmatn;font-size:14px;outline:none;resize:vertical;min-height:70px;line-height:1.8}
input[type=range]{flex:1;-webkit-appearance:none;height:3px;background:#1f1f1f;border-radius:3px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;background:#fff;border-radius:50%}
input[type=color]{width:38px;height:38px;border:1px solid #1f1f1f;border-radius:8px;background:transparent;cursor:pointer;padding:2px}
.upload{width:100%;background:transparent;border:1px dashed #1f1f1f;color:#888;padding:14px;border-radius:10px;font-family:inherit;font-size:13px;cursor:pointer;margin-bottom:10px}
.upload.has-img{border-color:#fff;color:#fff;border-style:solid;background:rgba(255,255,255,.05)}
#toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%) translateY(80px);background:#fff;color:#000;padding:10px 20px;border-radius:100px;font-size:13px;font-weight:700;opacity:0;transition:.3s;pointer-events:none;z-index:100}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.tabs{display:flex;gap:4px;margin-bottom:10px;border-bottom:1px solid #1f1f1f;padding-bottom:8px;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{background:transparent;border:0;color:#888;padding:6px 10px;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;border-radius:6px;white-space:nowrap}
.tab.active{background:#1f1f1f;color:#fff}
.panel{display:none}.panel.active{display:block}
.reset{background:#1f1f1f;color:#888;border:0;padding:8px 14px;border-radius:8px;font-family:inherit;font-size:12px;cursor:pointer;width:100%;margin-top:8px}
.section-title{font-size:11px;color:#666;margin:10px 0 6px;text-transform:uppercase;letter-spacing:1px}
.snap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:6px 0}
.snap-btn{aspect-ratio:1;background:transparent;border:1px solid #1f1f1f;color:#888;border-radius:8px;font-size:16px;cursor:pointer;font-family:inherit}
.snap-btn:active{background:#fff;color:#000}
.sticker-list{display:flex;flex-direction:column;gap:6px;margin-top:6px;max-height:180px;overflow-y:auto}
.sticker-item{display:flex;align-items:center;gap:8px;background:#0a0a0a;border:1px solid #1f1f1f;border-radius:8px;padding:6px 10px;font-size:12px}
.sticker-item.active{border-color:#fff;background:#1a1a1a}
.sticker-item img{width:32px;height:32px;object-fit:contain;background:#222;border-radius:4px}
.sticker-item span{flex:1;color:#aaa}
.sticker-item button{background:transparent;border:0;color:#ff2d55;cursor:pointer;font-size:14px}
.emoji-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:4px;margin:8px 0}
.emoji-btn{background:transparent;border:1px solid #1f1f1f;border-radius:6px;font-size:20px;padding:6px;cursor:pointer}
.emoji-btn:active{background:#1f1f1f}
</style>
</head>
<body>
<header><h1>STORY STUDIO</h1><button class="export" id="exportBtn">دانلود ↓</button></header>

<div class="layer-bar" id="layerBar">
<button class="layer-btn active" data-layer="img">🖼 پس‌زمینه</button>
<button class="layer-btn" data-layer="logo">🏷 لوگو</button>
