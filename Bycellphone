// ===== تعامل لمسی =====
var touchStart=null,initialDist=0,initialVal=1,pinchTarget=null;

function getTouchDist(t){
var dx=t[0].clientX-t[1].clientX;
var dy=t[0].clientY-t[1].clientY;
return Math.sqrt(dx*dx+dy*dy);
}

c.addEventListener('touchstart',function(e){
if(e.touches.length===1){
touchStart={
x:e.touches[0].clientX,
y:e.touches[0].clientY
};
if(s.activeLayer==='logo'&&s.logo){touchStart.lx=s.lx;touchStart.ly=s.ly;}
else if(s.activeLayer==='sticker'&&s.activeStickerIdx>=0){touchStart.lx=s.stickers[s.activeStickerIdx].x;touchStart.ly=s.stickers[s.activeStickerIdx].y;}
else if(s.activeLayer==='img'&&s.img){touchStart.lx=s.ix;touchStart.ly=s.iy;}
}else if(e.touches.length===2){
initialDist=getTouchDist(e.touches);
if(s.activeLayer==='logo'&&s.logo){pinchTarget='logo';initialVal=s.lw;}
else if(s.activeLayer==='sticker'&&s.activeStickerIdx>=0){pinchTarget='sticker';initialVal=s.stickers[s.activeStickerIdx].size;}
else if(s.activeLayer==='img'&&s.img){pinchTarget='img';initialVal=s.izoom;}
}
},{passive:true});

c.addEventListener('touchmove',function(e){
if(e.touches.length===1&&touchStart&&touchStart.lx!==undefined){
var dx=e.touches[0].clientX-touchStart.x;
var dy=e.touches[0].clientY-touchStart.y;
var rc=c.getBoundingClientRect();
// حساسیت ۱.۵ برابر
var k=1.5;
var nx=touchStart.lx-dx*k/rc.width;
var ny=touchStart.ly-dy*k/rc.height;
if(s.activeLayer==='logo'&&s.logo){
s.lx=Math.max(-0.1,Math.min(1.1,nx));
s.ly=Math.max(-0.1,Math.min(1.1,ny));
}else if(s.activeLayer==='sticker'&&s.activeStickerIdx>=0){
s.stickers[s.activeStickerIdx].x=Math.max(-0.1,Math.min(1.1,nx));
s.stickers[s.activeStickerIdx].y=Math.max(-0.1,Math.min(1.1,ny));
}else if(s.activeLayer==='img'&&s.img){
s.ix=Math.max(0,Math.min(1,nx));
s.iy=Math.max(0,Math.min(1,ny));
document.getElementById('imgX').value=Math.round(s.ix*100);
document.getElementById('imgY').value=Math.round(s.iy*100);
}
render();
}else if(e.touches.length===2&&pinchTarget){
var d=getTouchDist(e.touches);
var scale=d/initialDist;
if(pinchTarget==='logo'&&s.logo){
s.lw=Math.max(.01,Math.min(2,initialVal*scale));
document.getElementById('logoSize').value=Math.round(s.lw*100);
document.getElementById('logoSizeVal').textContent=Math.round(s.lw*100)+'%';
}else if(pinchTarget==='sticker'&&s.activeStickerIdx>=0){
s.stickers[s.activeStickerIdx].size=Math.max(.01,Math.min(2,initialVal*scale));
document.getElementById('stkSize').value=Math.round(s.stickers[s.activeStickerIdx].size*100);
document.getElementById('stkSizeVal').textContent=Math.round(s.stickers[s.activeStickerIdx].size*100)+'%';
}else if(pinchTarget==='img'&&s.img){
s.izoom=Math.max(.5,Math.min(4,initialVal*scale));
document.getElementById('imgZoom').value=Math.round(s.izoom*100);
}
render();
}
},{passive:true});

c.addEventListener('touchend',function(e){
if(e.touches.length===0){touchStart=null;pinchTarget=null;}
});

updateStickerList();
document.fonts.ready.then(render);render();
