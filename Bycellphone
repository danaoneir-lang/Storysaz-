<button class="snap-btn" data-snap="tc">↑</button>
<button class="snap-btn" data-snap="tr">↗</button>
<button class="snap-btn" data-snap="ml">←</button>
<button class="snap-btn" data-snap="mc">⊙</button>
<button class="snap-btn" data-snap="mr">→</button>
<button class="snap-btn" data-snap="bl">↙</button>
<button class="snap-btn" data-snap="bc">↓</button>
<button class="snap-btn" data-snap="br">↘</button>
</div>
<p style="font-size:11px;color:#666;text-align:center;margin-top:6px">💡 با انگشت جابه‌جا کن — دو انگشت = بزرگ‌نمایی</p>
<button class="reset" id="removeLogo">🗑 حذف لوگو</button>
</div>

<!-- استیکر -->
<div class="panel" id="tab-sticker">
<button class="upload" id="uploadSticker">✨ آپلود استیکر / تزئین</button>
<input type="file" id="fileSticker" accept="image/*" hidden>

<p class="section-title">ایموجی سریع (لمس کن تا اضافه شود):</p>
<div class="emoji-grid" id="emojiGrid"></div>

<p class="section-title">تنظیمات استیکر فعال:</p>
<div id="stickerControls" style="display:none">
<div class="row"><span class="label">اندازه <span id="stkSizeVal" style="color:#fff">20%</span></span><input type="range" id="stkSize" min="1" max="100" value="20"></div>
<div class="row"><span class="label">چرخش</span><input type="range" id="stkRot" min="-180" max="180" value="0"></div>
<div class="row"><span class="label">شفافیت</span><input type="range" id="stkOpacity" min="10" max="100" value="100"></div>
<p class="section-title">موقعیت سریع:</p>
<div class="snap-grid" id="stkSnapGrid">
<button class="snap-btn" data-snap="tl">↖</button>
<button class="snap-btn" data-snap="tc">↑</button>
<button class="snap-btn" data-snap="tr">↗</button>
<button class="snap-btn" data-snap="ml">←</button>
<button class="snap-btn" data-snap="mc">⊙</button>
<button class="snap-btn" data-snap="mr">→</button>
<button class="snap-btn" data-snap="bl">↙</button>
<button class="snap-btn" data-snap="bc">↓</button>
<button class="snap-btn" data-snap="br">↘</button>
</div>
<button class="reset" id="removeSticker">🗑 حذف استیکر فعال</button>
</div>

<p class="section-title">لیست استیکرها:</p>
<div class="sticker-list" id="stickerList"></div>
</div>

<!-- افکت -->
<div class="panel" id="tab-fx">
<p class="section-title">پریست آماده:</p>
<div class="chips" id="presets">
<button class="chip active" data-pr="none">اصلی</button>
<button class="chip" data-pr="fade">کمرنگ</button>
<button class="chip" data-pr="fadeSoft">محو ملایم</button>
<button class="chip" data-pr="blur">محو</button>
<button class="chip" data-pr="bw">سیاه و سفید</button>
<button class="chip" data-pr="sepia">سپیا</button>
<button class="chip" data-pr="warm">گرم</button>
<button class="chip" data-pr="cool">سرد</button>
<button class="chip" data-pr="vivid">پررنگ</button>
<button class="chip" data-pr="dreamy">رؤیایی</button>
<button class="chip" data-pr="dark">تاریک</button>
<button class="chip" data-pr="vintage">وینتیج</button>
</div>
<p class="section-title">تنظیم دستی:</p>
<div class="row"><span class="label">روشنایی</span><input type="range" id="fxBright" min="20" max="180" value="100"></div>
<div class="row"><span class="label">کنتراست</span><input type="range" id="fxContrast" min="20" max="200" value="100"></div>
<div class="row"><span class="label">محو</span><input type="range" id="fxBlur" min="0" max="30" value="0"></div>
<div class="row"><span class="label">اشباع رنگ</span><input type="range" id="fxSat" min="0" max="250" value="100"></div>
<div class="row"><span class="label">کمرنگی</span><input type="range" id="fxOpacity" min="20" max="100" value="100"></div>
<div class="row"><span class="label">وینیت</span><input type="range" id="fxVignette" min="0" max="100" value="0"></div>
<button class="reset" id="resetFx">↻ بازگشت</button>
</div>

<!-- دوگانه -->
<div class="panel" id="tab-dbl">
<button class="upload" id="uploadBtn2">📷 تصویر دوم</button>
<input type="file" id="fileInput2" accept="image/*" hidden>
<p class="section-title">حالت ترکیب:</p>
<div class="chips" id="blendModes">
