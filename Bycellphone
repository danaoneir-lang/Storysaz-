<button class="chip" data-bm="lighten">Lighten</button>
<button class="chip" data-bm="darken">Darken</button>
<button class="chip" data-bm="color-dodge">Dodge</button>
<button class="chip" data-bm="color-burn">Burn</button>
<button class="chip" data-bm="exclusion">Exclusion</button>
</div>
<div class="row"><span class="label">شدت</span><input type="range" id="dblOpacity" min="0" max="100" value="60"></div>
<div class="row"><span class="label">بزرگ‌نمایی</span><input type="range" id="dblZoom" min="50" max="250" value="100"></div>
