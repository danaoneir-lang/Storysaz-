</div>
</div>
</div>

<!-- فریم -->
<div class="panel" id="tab-frame">
<p class="section-title">قاب ساده:</p>
<div class="chips frame-group" id="frames">
<button class="chip active" data-fr="thin">نازک</button>
<button class="chip" data-fr="medium">متوسط</button>
<button class="chip" data-fr="thick">ضخیم</button>
<button class="chip" data-fr="double">دو خط</button>
<button class="chip" data-fr="triple">سه خط</button>
