function addSticker(opts){
var st={
img:opts.img||null,
emoji:opts.emoji||null,
x:.5,y:.5,
size:.2,
rot:0,
opacity:1,
w:1,h:1
};
if(st.img){st.w=st.img.width;st.h=st.img.height;}
s.stickers.push(st);
s.activeStickerIdx=s.stickers.length-1;
setActiveLayer('sticker');
updateStickerUI();
render();
updateStickerList();
}

function updateStickerUI(){
var ctrl=document.getElementById('stickerControls');
if(s.activeStickerIdx>=0&&s.stickers[s.activeStickerIdx]){
ctrl.style.display='block';
var st=s.stickers[s.activeStickerIdx];
document.getElementById('stkSize').value=Math.round(st.size*100);
document.getElementById('stkSizeVal').textContent=Math.round(st.size*100)+'%';
document.getElementById('stkRot').value=st.rot;
document.getElementById('stkOpacity').value=Math.round(st.opacity*100);
}else{
ctrl.style.display='none';
}
}

function updateStickerList(){
var list=document.getElementById('stickerList');
list.innerHTML='';
if(s.stickers.length===0){
list.innerHTML='<div style="color:#666;font-size:11px;text-align:center;padding:8px">هیچ استیکری اضافه نشده</div>';
return;
}
s.stickers.forEach(function(st,i){
var div=document.createElement('div');
div.className='sticker-item'+(i===s.activeStickerIdx?' active':'');
if(st.img){
var img=document.createElement('img');
img.src=st.img.src;
div.appendChild(img);
}else{
var sp=document.createElement('span');
sp.style.fontSize='24px';
sp.textContent=st.emoji;
div.appendChild(sp);
}
var name=document.createElement('span');
name.textContent=st.emoji?'ایموجی '+st.emoji:'استیکر '+(i+1);
div.appendChild(name);
var del=document.createElement('button');
del.textContent='✕';
del.onclick=function(ev){
ev.stopPropagation();
s.stickers.splice(i,1);
if(s.activeStickerIdx>=s.stickers.length)s.activeStickerIdx=s.stickers.length-1;
updateStickerUI();updateStickerList();render();
};
div.appendChild(del);
div.onclick=function(){
s.activeStickerIdx=i;
setActiveLayer('sticker');
updateStickerUI();updateStickerList();render();
};
list.appendChild(div);
});
}

