</div>
<div id="toast">ذخیره شد ✓</div>
<script>
var c=document.getElementById('c'),x=c.getContext('2d'),W=1080,H=1920;

var s={
img:null,ix:.5,iy:.5,izoom:1,
img2:null,i2x:.5,i2y:.5,i2zoom:1,blend:'source-over',i2opacity:.6,i2blur:0,i2gray:0,
logo:null,lx:.15,ly:.12,lw:.15,lrot:0,lopacity:1,
stickers:[],
text:'هر روز،\nیک قدم بهتر',
size:90,lineH:140,font:'Vazirmatn',txtColor:'#ffffff',
frame:'thin',frameColor:'#000000',frameWidth:6,framePad:40,cornerLen:140,innerFrame:'off',pos:'center',
fx:{bright:100,contrast:100,blur:0,sat:100,opacity:100,vignette:0},
activeLayer:'img',
activeStickerIdx:-1,
showGrid:false
};

var PRESETS={
none:{bright:100,contrast:100,blur:0,sat:100,opacity:100,vignette:0},
fade:{bright:115,contrast:80,blur:0,sat:70,opacity:70,vignette:0},
fadeSoft:{bright:110,contrast:90,blur:0,sat:90,opacity:88,vignette:0},
blur:{bright:105,contrast:100,blur:15,sat:100,opacity:100,vignette:0},
bw:{bright:100,contrast:110,blur:0,sat:0,opacity:100,vignette:0},
sepia:{bright:100,contrast:100,blur:0,sat:120,opacity:100,vignette:0,sepia:70},
warm:{bright:105,contrast:105,blur:0,sat:130,opacity:100,vignette:0,sepia:30},
cool:{bright:100,contrast:105,blur:0,sat:110,opacity:100,vignette:0,hue:-20},
vivid:{bright:105,contrast:130,blur:0,sat:170,opacity:100,vignette:0},
dreamy:{bright:115,contrast:90,blur:3,sat:125,opacity:100,vignette:25},
dark:{bright:65,contrast:120,blur:0,sat:110,opacity:100,vignette:45},
vintage:{bright:100,contrast:90,blur:0,sat:70,opacity:100,vignette:35,sepia:40}
};

function render(){
x.fillStyle='#ffffff';x.fillRect(0,0,W,H);
if(s.img)drawCover();
if(s.img2)drawDouble();
if(s.logo)drawLogo();
drawStickers();
drawFrame();
if(s.text.trim())drawText();
if(s.showGrid)drawGrid();
}

function drawCover(){
var r=s.img.width/s.img.height,cr=W/H,dw,dh;
if(r>cr){dh=H*s.izoom;dw=dh*r}else{dw=W*s.izoom;dh=dw/r}
var e=s.fx,parts=[];
parts.push('brightness('+e.bright+'%)');
parts.push('contrast('+e.contrast+'%)');
parts.push('saturate('+e.sat+'%)');
if(e.blur>0)parts.push('blur('+e.blur+'px)');
if(e.sepia)parts.push('sepia('+e.sepia+'%)');
if(e.hue)parts.push('hue-rotate('+e.hue+'deg)');
x.filter=parts.join(' ');
x.globalAlpha=e.opacity/100;
x.drawImage(s.img,(W-dw)*s.ix,(H-dh)*s.iy,dw,dh);
x.filter='none';x.globalAlpha=1;
if(e.vignette>0){
var g=x.createRadialGradient(W/2,H/2,H*.25,W/2,H/2,H*.75);
g.addColorStop(0,'rgba(0,0,0,0)');
g.addColorStop(1,'rgba(0,0,0,'+(e.vignette/100)+')');
x.fillStyle=g;x.fillRect(0,0,W,H);
}
}

function drawDouble(){
var r=s.img2.width/s.img2.height,cr=W/H,dw,dh;
if(r>cr){dh=H*s.i2zoom;dw=dh*r}else{dw=W*s.i2zoom;dh=dw/r}
var parts=[];
if(s.i2blur>0)parts.push('blur('+s.i2blur+'px)');
if(s.i2gray>0)parts.push('grayscale('+s.i2gray+'%)');
x.filter=parts.join(' ')||'none';
x.globalAlpha=s.i2opacity;
x.globalCompositeOperation=s.blend;
x.drawImage(s.img2,(W-dw)*s.i2x,(H-dh)*s.i2y,dw,dh);
x.globalCompositeOperation='source-over';
x.globalAlpha=1;x.filter='none';
}

function drawLogo(){
var lw=W*s.lw;
var lh=lw*(s.logo.height/s.logo.width);
x.save();
x.translate(s.lx*W,s.ly*H);
x.rotate(s.lrot*Math.PI/180);
x.globalAlpha=s.lopacity;
x.drawImage(s.logo,-lw/2,-lh/2,lw,lh);
x.restore();
}

function drawStickers(){
s.stickers.forEach(function(st,i){
var sw=W*st.size;
var sh=sw*(st.h/st.w);
x.save();
x.translate(st.x*W,st.y*H);
x.rotate(st.rot*Math.PI/180);
x.globalAlpha=st.opacity;
if(st.img){
x.drawImage(st.img,-sw/2,-sh/2,sw,sh);
}else if(st.emoji){
x.font=(sw*1.2)+'px serif';
x.textAlign='center';x.textBaseline='middle';
x.fillText(st.emoji,0,0);
}
// نشانگر استیکر فعال
if(i===s.activeStickerIdx&&s.activeLayer==='sticker'){
x.strokeStyle='rgba(0,128,255,.8)';
x.lineWidth=3;
x.setLineDash([10,6]);
x.strokeRect(-sw/2-8,-sh/2-8,sw+16,sh+16);
x.setLineDash([]);
}
x.restore();
});
}

function drawGrid(){
x.save();
x.strokeStyle='rgba(255,0,0,.4)';x.lineWidth=2;x.setLineDash([8,8]);
x.beginPath();
x.moveTo(W/3,0);x.lineTo(W/3,H);
x.moveTo(2*W/3,0);x.lineTo(2*W/3,H);
x.moveTo(0,H/3);x.lineTo(W,H/3);
x.moveTo(0,2*H/3);x.lineTo(W,2*H/3);
x.stroke();
x.strokeStyle='rgba(0,128,255,.6)';
x.beginPath();
x.moveTo(W/2,0);x.lineTo(W/2,H);
x.moveTo(0,H/2);x.lineTo(W,H/2);
x.stroke();
x.restore();
}

function drawFrame(){
if(s.frame==='none'&&s.innerFrame==='off')return;
x.strokeStyle=s.frameColor;x.fillStyle=s.frameColor;
x.lineCap='butt';x.lineJoin='miter';
var p=s.framePad,lw=s.frameWidth,cl=s.cornerLen,f=s.frame;

function bracket(cx,cy,dx,dy,len){
x.beginPath();
x.moveTo(cx+dx*len,cy);
x.lineTo(cx,cy);
x.lineTo(cx,cy+dy*len);
x.stroke();
}

if(f==='thin'||f==='medium'||f==='thick'){x.lineWidth=lw;x.strokeRect(p,p,W-p*2,H-p*2)}
else if(f==='double'){x.lineWidth=lw;x.strokeRect(p,p,W-p*2,H-p*2);x.strokeRect(p+lw*3,p+lw*3,W-(p+lw*3)*2,H-(p+lw*3)*2)}
else if(f==='triple'){x.lineWidth=lw;x.strokeRect(p,p,W-p*2,H-p*2);x.strokeRect(p+lw*3,p+lw*3,W-(p+lw*3)*2,H-(p+lw*3)*2);x.strokeRect(p+lw*6,p+lw*6,W-(p+lw*6)*2,H-(p+lw*6)*2)}
else if(f==='dashed'){x.lineWidth=lw;x.setLineDash([lw*5,lw*3]);x.strokeRect(p,p,W-p*2,H-p*2);x.setLineDash([])}
else if(f==='dotted'){x.lineWidth=lw;x.setLineDash([2,lw*2]);x.lineCap='round';x.strokeRect(p,p,W-p*2,H-p*2);x.setLineDash([]);x.lineCap='butt'}
else if(f==='rounded'){x.lineWidth=lw;x.beginPath();var r=60;x.moveTo(p+r,p);x.lineTo(W-p-r,p);x.arcTo(W-p,p,W-p,p+r,r);x.lineTo(W-p,H-p-r);x.arcTo(W-p,H-p,W-p-r,H-p,r);x.lineTo(p+r,H-p);x.arcTo(p,H-p,p,H-p-r,r);x.lineTo(p,p+r);x.arcTo(p,p,p+r,p,r);x.closePath();x.stroke()}
else if(f==='side'){x.fillRect(p,p,lw,H-p*2);x.fillRect(W-p-lw,p,lw,H-p*2)}
else if(f==='topBottom'){x.fillRect(p,p,W-p*2,lw);x.fillRect(p,H-p-lw,W-p*2,lw)}
else if(f==='oval'){x.lineWidth=lw;x.beginPath();x.ellipse(W/2,H/2,W/2-p,H/2-p,0,0,Math.PI*2);x.stroke()}
else if(f==='fullBox'){x.globalAlpha=.25;x.fillRect(p,p,W-p*2,H-p*2);x.globalAlpha=1;x.lineWidth=lw;x.strokeRect(p,p,W-p*2,H-p*2)}
else if(f==='gradient'){var g=x.createLinearGradient(p,p,W-p,H-p);g.addColorStop(0,s.frameColor);g.addColorStop(1,'rgba(255,255,255,0.15)');x.lineWidth=lw*2;x.strokeStyle=g;x.strokeRect(p,p,W-p*2,H-p*2)}
else if(f==='corner4'){x.lineWidth=lw;bracket(p,p,1,1,cl);bracket(W-p,p,-1,1,cl);bracket(p,H-p,1,-1,cl);bracket(W-p,H-p,-1,-1,cl)}
else if(f==='cornerDiag'){x.lineWidth=lw;bracket(p,p,1,1,cl);bracket(W-p,H-p,-1,-1,cl)}
else if(f==='cornerDiag2'){x.lineWidth=lw;bracket(W-p,p,-1,1,cl);bracket(p,H-p,1,-1,cl)}
else if(f==='cornerTop'){x.lineWidth=lw;bracket(p,p,1,1,cl);bracket(W-p,p,-1,1,cl)}
else if(f==='cornerBottom'){x.lineWidth=lw;bracket(p,H-p,1,-1,cl);bracket(W-p,H-p,-1,-1,cl)}
else if(f==='cornerLeft'){x.lineWidth=lw;bracket(p,p,1,1,cl);bracket(p,H-p,1,-1,cl)}
else if(f==='cornerRight'){x.lineWidth=lw;bracket(W-p,p,-1,1,cl);bracket(W-p,H-p,-1,-1,cl)}
else if(f==='cornerMix'){x.lineWidth=lw;var cl2=cl*.5;x.beginPath();x.moveTo(p+cl,p);x.lineTo(p,p);x.lineTo(p,p+cl);x.stroke();x.beginPath();x.moveTo(W-p-cl2,p);x.lineTo(W-p,p);x.lineTo(W-p,p+cl2);x.stroke();x.beginPath();x.moveTo(p,H-p-cl2);x.lineTo(p,H-p);x.lineTo(p+cl2,H-p);x.stroke();x.beginPath();x.moveTo(W-p-cl,H-p);x.lineTo(W-p,H-p);x.lineTo(W-p,H-p-cl);x.stroke()}
else if(f==='cross'){x.lineWidth=lw;x.beginPath();x.moveTo(p,p);x.lineTo(W-p,H-p);x.stroke();x.beginPath();x.moveTo(W-p,p);x.lineTo(p,H-p);x.stroke()}
else if(f==='crossCorners'){x.lineWidth=lw;var cc=cl*.5;x.beginPath();x.moveTo(p,p);x.lineTo(p+cc,p+cc);x.moveTo(p+cc,p);x.lineTo(p,p+cc);x.stroke();x.beginPath();x.moveTo(W-p,p);x.lineTo(W-p-cc,p+cc);x.moveTo(W-p-cc,p);x.lineTo(W-p,p+cc);x.stroke();x.beginPath();x.moveTo(p,H-p);x.lineTo(p+cc,H-p-cc);x.moveTo(p+cc,H-p);x.lineTo(p,H-p-cc);x.stroke();x.beginPath();x.moveTo(W-p,H-p);x.lineTo(W-p-cc,H-p-cc);x.moveTo(W-p-cc,H-p);x.lineTo(W-p,H-p-cc);x.stroke()}
else if(f==='diamond'){x.lineWidth=lw;x.beginPath();x.moveTo(W/2,p);x.lineTo(W-p,H/2);x.lineTo(W/2,H-p);x.lineTo(p,H/2);x.closePath();x.stroke()}
else if(f==='diamondCross'){x.lineWidth=lw;x.beginPath();x.moveTo(W/2,p);x.lineTo(W-p,H/2);x.lineTo(W/2,H-p);x.lineTo(p,H/2);x.closePath();x.stroke();x.beginPath();x.moveTo(W/2,p);x.lineTo(W/2,H-p);x.moveTo(p,H/2);x.lineTo(W-p,H/2);x.stroke()}
else if(f==='plus'){x.lineWidth=lw;x.beginPath();x.moveTo(W/2,p);x.lineTo(W/2,H-p);x.stroke();x.beginPath();x.moveTo(p,H/2);x.lineTo(W-p,H/2);x.stroke()}
else if(f==='arrow'){x.lineWidth=lw;var al=cl*.6;x.beginPath();x.moveTo(p+al,p+al*.3);x.lineTo(p+al*.3,p+al*.3);x.lineTo(p+al*.3,p+al);x.stroke();x.beginPath();x.moveTo(W-p-al,p+al*.3);x.lineTo(W-p-al*.3,p+al*.3);x.lineTo(W-p-al*.3,p+al);x.stroke();x.beginPath();x.moveTo(p+al,H-p-al*.3);x.lineTo(p+al*.3,H-p-al*.3);x.lineTo(p+al*.3,H-p-al);x.stroke();x.beginPath();x.moveTo(W-p-al,H-p-al*.3);x.lineTo(W-p-al*.3,H-p-al*.3);x.lineTo(W-p-al*.3,H-p-al);x.stroke()}

if(s.innerFrame!=='off'){
var ilw=s.innerFrame==='thin'?3:s.innerFrame==='medium'?8:16;
var ip=p+lw*2+15;
x.lineWidth=ilw;x.strokeStyle=s.frameColor;x.globalAlpha=.6;
x.strokeRect(ip,ip,W-ip*2,H-ip*2);x.globalAlpha=1;
}
}

function drawText(){
x.font='900 '+s.size+'px '+s.font+',sans-serif';
x.textAlign='center';x.textBaseline='middle';
var maxW=W-160,paragraphs=s.text.split('\n'),lines=[];
for(var p=0;p<paragraphs.length;p++){
var para=paragraphs[p].trim();
if(!para){lines.push('');continue}
var words=para.split(' '),cur='';
for(var i=0;i<words.length;i++){
var t=cur?cur+' '+words[i]:words[i];
if(x.measureText(t).width>maxW&&cur){lines.push(cur);cur=words[i]}else cur=t;
}
if(cur)lines.push(cur);
}
var lh=s.size*(s.lineH/100),th=lines.length*lh,baseY;
if(s.pos==='top')baseY=200+th/2;
else if(s.pos==='bottom')baseY=H-200-th/2;
else baseY=H/2;
var startY=baseY-(th-lh)/2;
for(var j=0;j<lines.length;j++){
if(!lines[j])continue;
var y=startY+j*lh;
x.shadowColor='rgba(0,0,0,.35)';x.shadowBlur=15;x.shadowOffsetY=3;
x.lineWidth=s.size*.13;x.strokeStyle='#000';x.lineJoin='round';x.miterLimit=2;
x.strokeText(lines[j],W/2,y);
x.shadowColor='transparent';x.shadowBlur=0;x.shadowOffsetY=0;
x.fillStyle=s.txtColor;x.fillText(lines[j],W/2,y);
}
}

